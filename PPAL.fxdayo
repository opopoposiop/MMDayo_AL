#include "../hlsl/resources_pp.hlsli"
#include "../hlsl/yrz.hlsli"
using namespace Dayo;
using namespace YRZ;

[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
        "category": "postprocess",
        "controllers": [
            {"name":"C_off", "controllerName":"(self)", "item":"off", "type":"float"},
            {"name":"C_Si",  "controllerName":"(self)", "item":"Si",  "type":"float"},
            {"name":"C_Tr",  "controllerName":"(self)", "item":"Tr",  "type":"float"},
            {"name":"C_X",   "controllerName":"(self)", "item":"X",   "type":"float"},
            {"name":"C_Y",   "controllerName":"(self)", "item":"Y",   "type":"float"},
            {"name":"C_Z",   "controllerName":"(self)", "item":"Z",   "type":"float"}
        ],
        "samplers": [
            { "name":"samp",      "filter":"ANISOTROPIC" },
            { "name":"PointSamp", "filter":"POINT", "addressU":"CLAMP", "addressV":"CLAMP" }
        ],
        "textures": [
            {"name":"Emissive",  "format":"R16G16B16A16_FLOAT", "view":"RTV"},
            {"name":"TightH",    "format":"R16G16B16A16_FLOAT", "view":"RTV"},
            {"name":"TightBloom","format":"R16G16B16A16_FLOAT", "view":"RTV"},
            {"name":"WideH",     "format":"R16G16B16A16_FLOAT", "view":"RTV"},
            {"name":"WideBloom", "format":"R16G16B16A16_FLOAT", "view":"RTV"},
            {"name":"GlareBuf",  "format":"R16G16B16A16_FLOAT", "view":"RTV"}
        ],
        "passes": [
            {
                "name": "EmissiveExtract", "type": "postprocess",
                "vertexShader": "VS", "pixelShader": "PS",
                "RTV": [ {"name":"Emissive"} ]
            },
            {
                "name": "BloomBlurH", "type": "postprocess",
                "vertexShader": "VS", "pixelShader": "PS",
                "RTV": [ {"name":"TightH"} ]
            },
            {
                "name": "BloomBlurV", "type": "postprocess",
                "vertexShader": "VS", "pixelShader": "PS",
                "RTV": [ {"name":"TightBloom"} ]
            },
            {
                "name": "BloomBlurH_Wide", "type": "postprocess",
                "vertexShader": "VS", "pixelShader": "PS",
                "RTV": [ {"name":"WideH"} ]
            },
            {
                "name": "BloomBlurV_Wide", "type": "postprocess",
                "vertexShader": "VS", "pixelShader": "PS",
                "RTV": [ {"name":"WideBloom"} ]
            },
            {
                "name": "Glare", "type": "postprocess",
                "vertexShader": "VS", "pixelShader": "PS",
                "RTV": [ {"name":"GlareBuf"} ]
            },
            {
                "name": "BloomComposite", "type": "postprocess",
                "vertexShader": "VS", "pixelShader": "PS"
            }
        ]
    }
}
[HLSL]

// PPAL.fxdayo  —  Post-Process AutoLuminous
//
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MikuMikuDayo 用 AutoLuminous 互換ポストプロセス
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// 【パス構成 / テクスチャフロー】
//
//   EmissiveExtract  → [Emissive RTV] 発光色抽出
//   BloomBlurH       → [TightH RTV]   タイト層水平ガウスぼかし
//   BloomBlurV       → [TightBloom]   タイト層垂直ガウスぼかし
//   BloomBlurH_Wide  → [WideH RTV]    ワイド層水平ガウスぼかし (Emissive から)
//   BloomBlurV_Wide  → [WideBloom]    ワイド層垂直ガウスぼかし
//   Glare            → [GlareBuf]     星形グレア (TightBloom から)
//   BloomComposite   → [RTOutput]     最終合成 (ScreenTexture + 3層加算)
//
// 【AutoLuminous 発光指定方式】
//   方式A（材質指定）: スペキュラ色=黒(0,0,0)、shininess≥100
//   方式B（追加UV）:   追加UV1.xy≈(0.2,0.7) の頂点
//
// 【PPAL.pmx コントローラパラメータ】
//   off モーフ: 0=全開、1=消灯
//   Si  モーフ: 発光強度 (0=標準×1, -1=消灯, +1=×2)
//   Tr  モーフ: ぼかし低減 (0=最大, 1=最小) ※増加不可
//   X   モーフ: 光芒方向数 0〜9
//   Y   モーフ: 元画面輝度 (0=変化なし, -100=完全黒, +100=×2)
//   Z   モーフ: 発光強度 AL-Z規格 (-100〜500)

// Radeon向け: bindlessテクスチャ添え字は NonUniformResourceIndex で囲う
#define NURI NonUniformResourceIndex

// コントローラ変数 C_off / C_Si / C_Tr / C_X / C_Y / C_Z は
// フレームワークが controllers 定義から自動宣言するため手動宣言不要。

// ============================================================
// AutoLuminous 互換パラメータ
// ============================================================
static const float AL_SPEC_THRESHOLD    = 0.05;
static const float AL_SHIN_THRESHOLD    = 100.0;
static const float AL_MAX_OVERBRIGHT    = 16.0;  // 8.0 → 16.0: 高輝度発光に対応

// ── タイト層 Bloom ──
static const float BLOOM_INTENSITY      = 1.20;  // 0.50 → 1.20: 近接グロー強化
static const float BLOOM_SIGMA          = 5.0;   // 3.0  → 5.0:  ぼかし幅を広げる
static const int   BLOOM_RADIUS         = 9;     // 6    → 9:    サンプル範囲拡大

// ── ワイド層 Bloom ──
static const float BLOOM_WIDE_INTENSITY = 0.60;  // 0.20 → 0.60: 遠方への広がり強化
static const float BLOOM_WIDE_SIGMA     = 20.0;  // 12.0 → 20.0: より広範囲に拡散
static const int   BLOOM_WIDE_RADIUS    = 24;    // 16   → 24:   サンプル範囲拡大

// ── 光芒 (グレア) ──
static const int   GLARE_STEPS          = 16;
static const float GLARE_STEP_SIZE      = 8.0;
static const float GLARE_DECAY          = 0.15;
static const float GLARE_INTENSITY      = 0.50;  // 0.30 → 0.50: 光芒を強調


// ============================================================
// 共通 VSO / VS  (全パス共通)
// ============================================================
struct VSO {
	float4 position : SV_POSITION;
	float2 uv       : TEXCOORD;
};

VSO VS(float4 pos : POSITION, float2 uv : TEXCOORD)
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}


// ============================================================
// EmissiveExtract パス  → Emissive RTV
//   ※ ここだけ bindless リソースを参照するため、
//     CalcAutoLuminousPostProcess / HSVtoRGBLocal を
//     このパスのガード内にのみ定義する。
//     （他パスでコンパイルさせないことでコンパイル時間を削減）
// ============================================================
#ifdef YRZ_PASS_EmissiveExtract

// ヘルパー: HSV → RGB  (方式B カラーモード 1 用)
float3 HSVtoRGBLocal(float3 hsv)
{
	float h = hsv.x * 6.0;
	float s = hsv.y;
	float v = hsv.z;
	float i = floor(h);
	float f = h - i;
	float p = v * (1.0 - s);
	float q = v * (1.0 - s * f);
	float t = v * (1.0 - s * (1.0 - f));
	int   ii = (int)i % 6;
	if (ii == 0) return float3(v, t, p);
	if (ii == 1) return float3(q, v, p);
	if (ii == 2) return float3(p, v, t);
	if (ii == 3) return float3(p, q, v);
	if (ii == 4) return float3(t, p, v);
	             return float3(v, p, q);
}


// AutoLuminous 発光色計算
//   GBuffer1 / GBuffer2 / VB / IB / MMDMaterials / Textures を
//   ポストプロセス側から参照して発光色を返す。
//   ※ bindless バッファは直接ダブルインデックス VB[NURI(x)][i] で参照する
float3 CalcAutoLuminousPostProcess(uint imo, uint iface, uint2 pix)
{
	// ── 重心座標の復元 ──────────────────────────────────────
	float2 st   = GBuffer2[pix];
	float3 bary = float3(1.0 - st.x - st.y, st.x, st.y);

	// ── 頂点インデックス取得 ────────────────────────────────
	uint ibase = iface * 3u;
	uint i0 = IB[NURI(imo)][ibase + 0u];
	uint i1 = IB[NURI(imo)][ibase + 1u];
	uint i2 = IB[NURI(imo)][ibase + 2u];

	// ── 頂点データ取得 ──────────────────────────────────────
	Vertex v0 = VB[NURI(imo)][i0];
	Vertex v1 = VB[NURI(imo)][i1];
	Vertex v2 = VB[NURI(imo)][i2];

	// ── テクスチャ UV 再構築 ────────────────────────────────
	float2 uv = bary.x * v0.uv + bary.y * v1.uv + bary.z * v2.uv;

	// ── 追加 UV 再構築 (方式B 判定用) ──────────────────────
	float4 exuv1 = bary.x * v0.exuv[0] + bary.y * v1.exuv[0] + bary.z * v2.exuv[0];
	float4 exuv2 = bary.x * v0.exuv[1] + bary.y * v1.exuv[1] + bary.z * v2.exuv[1];
	float4 exuv3 = bary.x * v0.exuv[2] + bary.y * v1.exuv[2] + bary.z * v2.exuv[2];

	// ── 方式B: 頂点発光 (識別コード確認) ────────────────────
	bool isVertexLuminous = (abs(exuv1.x - 0.2) < 0.05) && (abs(exuv1.y - 0.7) < 0.05);
	if (isVertexLuminous)
	{
		float blinkFactor = 1.0;
		float period = exuv1.z;
		if (abs(period) > 1e-4) {
			float phase = exuv3.y;
			float theta = 2.0 * PI * (Time + phase) / abs(period);
			if (period > 0.0)
				blinkFactor = saturate(0.5 + 0.5 * sin(theta));
			else
				blinkFactor = step(0.0, sin(theta));
		}
		if (exuv3.z > 0.5)
			blinkFactor = 1.0;

		int  flags     = (int)round(exuv1.w);
		int  texMode   = flags % 10;
		int  colorMode = (flags / 10) % 10;

		float3 emitColor = exuv2.xyz;
		if (colorMode == 1)
			emitColor = HSVtoRGBLocal(saturate(exuv2.xyz));

		uint imat = Faces[NURI(imo)][iface];
		MMDMaterial m2 = MMDMaterials[NURI(imo)][imat];
		uint tidx = TextureTable[imo];

		if (texMode == 0 && m2.tex >= 0) {
			float4 texCol = Textures[NURI(tidx + m2.tex)].Sample(samp, uv);
			texCol.rgb = lerp(1.0,
			                  texCol.rgb * m2.textureMulValue.rgb + m2.textureAddValue.rgb,
			                  m2.textureMulValue.a + m2.textureAddValue.a);
			emitColor *= lerp(1.0, texCol.rgb, max(0.0, exuv3.x));
		}
		else if (texMode == 2 && m2.tex >= 0) {
			float4 texCol = Textures[NURI(tidx + m2.tex)].Sample(samp, uv);
			texCol.rgb = lerp(1.0,
			                  texCol.rgb * m2.textureMulValue.rgb + m2.textureAddValue.rgb,
			                  m2.textureMulValue.a + m2.textureAddValue.a);
			float luma = dot(texCol.rgb, float3(0.299, 0.587, 0.114));
			emitColor *= smoothstep(0.4, 0.6, luma);
		}

		float power = clamp(exuv2.w, 0.0, AL_MAX_OVERBRIGHT);
		return ToLinear(saturate(emitColor)) * power * blinkFactor;
	}

	// ── 方式A: 材質発光 ──────────────────────────────────────
	uint imat2 = Faces[NURI(imo)][iface];
	MMDMaterial m = MMDMaterials[NURI(imo)][imat2];
	float specMax    = max(m.specular.r, max(m.specular.g, m.specular.b));
	bool  isEmissive = (specMax <= AL_SPEC_THRESHOLD) && (m.shininess >= AL_SHIN_THRESHOLD);
	if (!isEmissive)
		return 0;

	float emissiveScale = clamp(
		(m.shininess - AL_SHIN_THRESHOLD) / 10.0,
		0.0, AL_MAX_OVERBRIGHT);

	float3 glowBase = m.diffuse.rgb + m.ambient;

	uint tidxA = TextureTable[imo];
	if (m.tex >= 0) {
		float4 texCol = Textures[NURI(tidxA + m.tex)].Sample(samp, uv);
		texCol.rgb = lerp(1.0,
		                  texCol.rgb * m.textureMulValue.rgb + m.textureAddValue.rgb,
		                  m.textureMulValue.a + m.textureAddValue.a);
		glowBase *= texCol.rgb;
	}

	return ToLinear(saturate(glowBase)) * emissiveScale;
}


float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix = (uint2)vso.position.xy;

	uint2 gb  = GBuffer1[pix];
	uint  imo = gb.r;
	if (imo == Inai) return 0;

	uint   iface = gb.g;
	float3 emissive = CalcAutoLuminousPostProcess(imo, iface, pix);

	// Si / Z / off の合算スケール
	float Si_factor  = max(0.0, 1.0 + C_Si);
	float Z_factor   = max(0.0, (100.0 + C_Z) / 100.0);
	float off_factor = saturate(1.0 - C_off);
	float globalScale = Si_factor * Z_factor * off_factor;

	return float4(emissive * globalScale, 1.0);
}

#endif  // YRZ_PASS_EmissiveExtract


// ============================================================
// BloomBlurH パス  Emissive → TightH RTV
//   タイト層 水平ガウスぼかし
//   C_Tr によるぼかし幅制御: σ = BLOOM_SIGMA × max(0.05, 1 − C_Tr)
// ============================================================
#ifdef YRZ_PASS_BloomBlurH

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix    = (uint2)vso.position.xy;
	int2   bound  = int2(Resolution) - 1;
	float  sigma  = max(0.05, BLOOM_SIGMA * (1.0 - saturate(C_Tr)));
	float  inv2s2 = 1.0 / (2.0 * sigma * sigma);

	float3 result = 0;
	float  totalW = 0;

	[loop]
	for (int i = -BLOOM_RADIUS; i <= BLOOM_RADIUS; i++) {
		float w   = exp(-(float)(i * i) * inv2s2);
		int2  src = clamp(int2(pix) + int2(i, 0), int2(0, 0), bound);
		result   += Emissive[src].rgb * w;
		totalW   += w;
	}

	return float4(result / max(totalW, 1e-5), 1.0);
}

#endif


// ============================================================
// BloomBlurV パス  TightH → TightBloom RTV
//   タイト層 垂直ガウスぼかし
// ============================================================
#ifdef YRZ_PASS_BloomBlurV

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix    = (uint2)vso.position.xy;
	int2   bound  = int2(Resolution) - 1;
	float  sigma  = max(0.05, BLOOM_SIGMA * (1.0 - saturate(C_Tr)));
	float  inv2s2 = 1.0 / (2.0 * sigma * sigma);

	float3 result = 0;
	float  totalW = 0;

	[loop]
	for (int i = -BLOOM_RADIUS; i <= BLOOM_RADIUS; i++) {
		float w   = exp(-(float)(i * i) * inv2s2);
		int2  src = clamp(int2(pix) + int2(0, i), int2(0, 0), bound);
		result   += TightH[src].rgb * w;
		totalW   += w;
	}

	return float4(result / max(totalW, 1e-5), 1.0);
}

#endif


// ============================================================
// BloomBlurH_Wide パス  Emissive → WideH RTV
//   ワイド層 水平ガウスぼかし (Emissive から独立して読む)
// ============================================================
#ifdef YRZ_PASS_BloomBlurH_Wide

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix    = (uint2)vso.position.xy;
	int2   bound  = int2(Resolution) - 1;
	float  sigma  = max(0.05, BLOOM_WIDE_SIGMA * (1.0 - saturate(C_Tr)));
	float  inv2s2 = 1.0 / (2.0 * sigma * sigma);

	float3 result = 0;
	float  totalW = 0;

	[loop]
	for (int i = -BLOOM_WIDE_RADIUS; i <= BLOOM_WIDE_RADIUS; i++) {
		float w   = exp(-(float)(i * i) * inv2s2);
		int2  src = clamp(int2(pix) + int2(i, 0), int2(0, 0), bound);
		result   += Emissive[src].rgb * w;
		totalW   += w;
	}

	return float4(result / max(totalW, 1e-5), 1.0);
}

#endif


// ============================================================
// BloomBlurV_Wide パス  WideH → WideBloom RTV
//   ワイド層 垂直ガウスぼかし
// ============================================================
#ifdef YRZ_PASS_BloomBlurV_Wide

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix    = (uint2)vso.position.xy;
	int2   bound  = int2(Resolution) - 1;
	float  sigma  = max(0.05, BLOOM_WIDE_SIGMA * (1.0 - saturate(C_Tr)));
	float  inv2s2 = 1.0 / (2.0 * sigma * sigma);

	float3 result = 0;
	float  totalW = 0;

	[loop]
	for (int i = -BLOOM_WIDE_RADIUS; i <= BLOOM_WIDE_RADIUS; i++) {
		float w   = exp(-(float)(i * i) * inv2s2);
		int2  src = clamp(int2(pix) + int2(0, i), int2(0, 0), bound);
		result   += WideH[src].rgb * w;
		totalW   += w;
	}

	return float4(result / max(totalW, 1e-5), 1.0);
}

#endif


// ============================================================
// Glare パス  TightBloom → GlareBuf RTV
//   星形グレア生成
//   C_X=0: GlareBuf を黒クリア (計算スキップ)
//   C_X=N: N 方向 (各方向に正逆 2 本のスポーク)
// ============================================================
#ifdef YRZ_PASS_Glare

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix     = (uint2)vso.position.xy;
	int2   bound   = int2(Resolution) - 1;
	int    numDirs = clamp((int)round(C_X), 0, 9);

	float3 glare = 0.0;

	if (numDirs > 0)
	{
		[loop]
		for (int d = 0; d < numDirs; d++)
		{
			float  angle  = (float)d * PI / (float)numDirs;
			float2 dir    = float2(cos(angle), sin(angle));

			float3 streak = 0.0;
			float  wTotal = 0.0;

			[loop]
			for (int s = 1; s <= GLARE_STEPS; s++)
			{
				float  w      = exp(-(float)s * GLARE_DECAY);
				float2 offset = dir * ((float)s * GLARE_STEP_SIZE);
				int2 srcP = clamp(int2(pix) + int2(offset),  int2(0, 0), bound);
				int2 srcN = clamp(int2(pix) - int2(offset),  int2(0, 0), bound);
				streak += (TightBloom[srcP].rgb + TightBloom[srcN].rgb) * w;
				wTotal += 2.0 * w;
			}

			glare += streak / max(wTotal, 1e-5);
		}

		glare /= (float)numDirs;
	}

	return float4(glare, 1.0);
}

#endif


// ============================================================
// BloomComposite パス  → RTOutput (SV_TARGET)
//   ① Y パラメータで元画面輝度調整
//   ② TightBloom / WideBloom / GlareBuf を加算合成
//   ScreenTexture から現フレーム内容を読み、SV_TARGET で出力
// ============================================================
#ifdef YRZ_PASS_BloomComposite

float4 PS(VSO vso) : SV_TARGET
{
	uint2  pix   = (uint2)vso.position.xy;
	float3 tight = TightBloom[pix].rgb;
	float3 wide  = WideBloom[pix].rgb;
	float3 glare = GlareBuf[pix].rgb;

	float brightnessMult = max(0.0, (100.0 + C_Y) / 100.0);
	float4 color = ScreenTexture[pix];
	color.rgb *= brightnessMult;

	color.rgb += tight * BLOOM_INTENSITY
	           + wide  * BLOOM_WIDE_INTENSITY
	           + glare * GLARE_INTENSITY;

	// 輝点コア強調: ワイド層の二乗成分を加算することで
	// 高輝度ピクセル周辺のコアを際立たせる
	color.rgb += wide * wide * 2.0;

	return color;
}

#endif
